import serial
import time
import numpy as np


# Configuration
PORT = 'COM9'
BAUD_RATE = 115200
WINDOW_SIZE = 6000 

def generate_window(condition):
    data_window = []
    try:
        filename = 'apnea_data.txt' if condition == 'APNEA' else 'normal_data.txt'
        
        with open(filename, 'r') as f:
            raw_text = f.read().replace('\n', ',').replace('f', '')
            data_window = [float(x) for x in raw_text.split(',') if x.strip()]
                
        if len(data_window) > WINDOW_SIZE:
            data_window = data_window[:WINDOW_SIZE]
        elif len(data_window) < WINDOW_SIZE:
            data_window += [0.0] * (WINDOW_SIZE - len(data_window))

        print(f"\n   📁 LOADED {condition} - {len(data_window)} samples")
        # Just print stats, don't change data!
        print(f"   📊 RAW STATS: Range=[{min(data_window):.4f}, {max(data_window):.4f}]")
            
    except Exception as e:
        print(f"⚠️ Error: {e}")
        return np.random.normal(0, 1, WINDOW_SIZE).tolist()

    return data_window # Return exactly what was loaded

def run_simulation():
    try:
        print(f"🔌 Connecting to {PORT}...")
        ser = serial.Serial(PORT, BAUD_RATE, timeout=1)
        time.sleep(2)
        
        # Clear any stale data
        ser.reset_input_buffer()
        ser.reset_output_buffer()
        
        test_sequence = ['NORMAL', 'APNEA', 'NORMAL']
        
        for test_num, condition in enumerate(test_sequence, 1):
            print(f"\n{'='*60}")
            print(f"TEST {test_num}/3: {condition} Patient Data")
            print(f"{'='*60}")
            
            data_window = generate_window(condition)
            
            print(f"\n📤 Sending {len(data_window)} samples to STM32...")
            
            # Send data
            for i, val in enumerate(data_window):
                msg = f"{val:.8f}\n" 
                ser.write(msg.encode('utf-8'))
                
                if i % 1000 == 0:
                    print(f"   Progress: {i}/{WINDOW_SIZE} sent...")

            print(f"   ✅ All samples sent!")
            
            # Verify first/last values sent
            print(f"\n   📤 TRANSMITTED:")
            print(f"      First: {data_window[0]:.8f}")
            print(f"      Last:  {data_window[-1]:.8f}")
            
            # Wait for STM32 response
            print(f"\n⏳ Waiting for STM32 diagnosis...")
            start_wait = time.time()
            responses = []
            
            while time.time() - start_wait < 5.0:
                if ser.in_waiting:
                    try:
                        line = ser.readline().decode().strip()
                        if line:
                            responses.append(line)
                            print(f"   📨 STM32: {line}")
                    except Exception as e:
                        print(f"   ⚠️ Decode error: {e}")
            
            # Analyze result
            print(f"\n📊 ANALYSIS:")
            for response in responses:
                if "HIL Result:" in response:
                    score = float(response.split(":")[-1].strip())
                    prediction = "APNEA" if score > 0.5 else "NORMAL"
                    match = "✅ CORRECT" if prediction == condition else "❌ WRONG"
                    print(f"   Prediction: {prediction} (score={score:.4f}) {match}")
                    
            time.sleep(1)
                        
    except Exception as e:
        print(f"❌ Error: {e}")
        import traceback
        traceback.print_exc()
    finally:
        if 'ser' in locals() and ser.is_open:
            ser.close()
            print("\n🔌 Serial port closed")

if __name__ == "__main__":
    print("🚀 Starting Hardware-in-Loop Simulation")
    print("="*60)
    run_simulation()
    print("\n✅ Simulation complete!")